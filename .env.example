# Agomoni Root Environment Variables Example (Safe Placeholders)

# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection
# For local dev / testing SQLite:
DATABASE_URL="file:./dev.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/agomoni_db?schema=public"

# Redis Cache & Sessions (Optional in dev, required in production clustering)
REDIS_URL=redis://localhost:6379

# JWT Secrets (Generate with `openssl rand -hex 32`)
JWT_SECRET=your_jwt_secret_dev_key_super_secure_32_bytes_min
JWT_REFRESH_SECRET=your_refresh_secret_dev_key_super_secure_32_bytes_min
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Razorpay Credentials (Test keys for development, Live keys for production)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# AI Outfit Generator Configuration
# Options: AUTO | HUGGINGFACE | OPENAI | GEMINI | CLAUDE | QWEN | REPLICATE | DEVELOPMENT_MOCK
AI_PROVIDER=AUTO
AI_API_KEY=your_ai_api_key
GEMINI_API_KEY=your_gemini_api_key
HF_TOKEN=your_hugging_face_token_here
HUGGINGFACE_API_KEY=your_hugging_face_token_here
OPENAI_API_KEY=your_openai_api_key_here
REPLICATE_API_TOKEN=your_replicate_token_here
QWEN_API_KEY=your_qwen_api_key
QWEN_BASE_URL=https://api-inference.modelscope.cn/v1
QWEN_MODEL=wanx-v1

# Google OAuth Server Verification
GOOGLE_CLIENT_ID=your_google_client_id

# File Upload / Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# Push Notifications (Web Push VAPID keys)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@agomoni.in

# Frontend (Vite) Environment Variables
VITE_API_URL=http://localhost:4000
VITE_GOOGLE_CLIENT_ID=your_google_client_id
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
