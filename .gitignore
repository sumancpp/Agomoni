# ==============================================================================
# Agomoni — Production Git Ignore Rules
# ==============================================================================

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Environment / Secrets (Never commit secrets to git)
.env
.env.*
!.env.example
!.env.sample

**/.env
**/.env.*
!**/.env.example
!**/.env.sample

# Local Databases (SQLite, dev databases, journals)
*.db
*.db-journal
*.db-wal
*.db-shm
**/*.db
**/*.db-journal
*.sqlite
*.sqlite3
apps/api/dev.db
apps/api/dev.db-journal
apps/api/src/prisma/dev.db
apps/api/src/prisma/dev.db-journal

# Machine Learning & AI Models (Large binary weights over 100MB)
*.onnx
*.pt
*.pth
*.bin
*.safetensors
*.h5
*.tflite
models/
**/models/*.onnx
apps/api/models/*
!apps/api/models/.gitkeep

# Python Virtual Environments & Bytecode
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
test_venv/
**/test_venv/
*venv/
*.egg-info/
.pytest_cache/

# Build & Compilation Outputs
dist/
**/dist/
build/
**/build/
out/
.next/
.nuxt/
.vite/
*.tsbuildinfo

# Uploaded User Media & Dynamic Files
uploads/*
!uploads/.gitkeep
apps/api/uploads/*
!apps/api/uploads/.gitkeep
!apps/api/uploads/outfits
!apps/api/uploads/outfits/*
storage/

# Cache Directories
.cache/
.parcel-cache/
.eslintcache
.turbo/

# Scratch & Ad-hoc Verification Scripts
scratch/
**/scratch/
test_lost_found_two_accounts.mjs

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test Artifacts & Coverage
coverage/
**/coverage/
.nyc_output/

# Temporary Files
tmp/
temp/
*.tmp
*.temp

# OS-Specific Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Configurations
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# Runtime & Process IDs
*.pid
*.seed
