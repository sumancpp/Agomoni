# Agomoni API Environment Variables Example (Safe Placeholders)

PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (SQLite in local dev, PostgreSQL in production)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/agomoni_db?schema=public"

# Redis Cache & Sessions (Optional in dev, required in production clustering)
REDIS_URL=redis://localhost:6379

# JWT Secrets (Generate with `openssl rand -hex 32`)
JWT_SECRET=your_jwt_secret_minimum_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_minimum_32_characters_long
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Razorpay Credentials (Test keys for development, Live keys for production)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# AI Stylist & Outfits Configuration
# Options: AUTO | HUGGINGFACE | OPENAI | GEMINI | CLAUDE | QWEN | REPLICATE | DEVELOPMENT_MOCK
AI_PROVIDER=AUTO
AI_API_KEY=your_ai_api_key
GEMINI_API_KEY=your_gemini_api_key
HF_TOKEN=your_hugging_face_token_here
HUGGINGFACE_API_KEY=your_hugging_face_token_here
OPENAI_API_KEY=your_openai_api_key_here
REPLICATE_API_TOKEN=your_replicate_token_here
QWEN_API_KEY=your_qwen_api_key
QWEN_BASE_URL=https://api-inference.modelscope.cn/v1
QWEN_MODEL=wanx-v1

# Google OAuth Server Verification
GOOGLE_CLIENT_ID=your_google_client_id

# File Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
